{
  "name": "git-gimme",
  "version": "1.0.1",
  "type": "module",
  "description": "git subcommand: download a single file or folder from a repo without a full clone",
  "author": "jayF0x",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "git-gimme": "dist/cli.js"
  },
  "peerDependencies": {
    "giget": ">=3.3.0"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config config/vite.config.ts",
    "dev": "vite build --watch --config config/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run build",
    "test": "bun test",
    "test:run": "bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "scan": "bash ./scripts/opengrep-scan.sh",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "npm:deploy": "bash ./scripts/npm/publish-npm.sh",
    "repo:bootstrap": "bash ./scripts/bootstap.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "bun-types": "^1.3.14",
    "giget": ">=3.3.0",
    "taglify": "^1.2.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "git",
    "cli",
    "giget",
    "github",
    "download",
    "subcommand",
    "sparse-checkout",
    "tarball"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayf0x/git-gimme.git"
  },
  "homepage": "https://github.com/jayf0x/git-gimme#readme",
  "bugs": {
    "url": "https://github.com/jayf0x/git-gimme/issues"
  }
}
